@using Syncfusion.Blazor.Navigations.Internal
@using Syncfusion.Blazor.Internal
@typeparam TValue
@inherits SfMenuBase<TValue>;
@namespace Syncfusion.Blazor.Navigations

<CspStyleSourceProvider></CspStyleSourceProvider> 
@if (!SyncfusionService.IsModuleInitComponentInitialized)
{
    SyncfusionService.IsModuleInitComponentInitialized = true;
    <ModuleInitComponent></ModuleInitComponent>
}

<SfMediaQuery OnBreakpointChanged="OnBreakPointChanged"></SfMediaQuery>

<div @ref="Element" class="@containerClass" id="@id" role="navigation" aria-label="@ariaLabel">
    @{
        List<TValue>? items = Items; List<ClassCollection> itemClasses = ClsCollection;
        if (NavIdx.Count == 0) { cmenuHidden = ""; }
        @for (var i = 0; i < NavIdx.Count; i++)
        {
            string cls; TValue? parentItem = default!; ItemModel<TValue>? parentMenuItem = default;
            @if (i == 0)
            {
                items = Items;
                cls = IsMenu ? SUBMENU : CONTEXTMENU;
            }
            else 
            {
                if (items != null)
                {
                    parentItem = items.ElementAtOrDefault(this.NavIdx[i]);
                    if (parentItem != null)
                    {
                        parentMenuItem = GetMenuItem(parentItem);
                        items = (List<TValue>)parentMenuItem.Items;
                        itemClasses = itemClasses[this.NavIdx[i]].ClassList;
                    }
                }
                cls = SUBMENU;
            }
            if ((i == NavIdx.Count - 1 && OpenEventArgs != null && OpenEventArgs.NavigationIndex == i) || (!IsMenu && target !=""))
                cls += TRANSPARENT;
            if (IsDevice && i != NavIdx.Count - 1)
                continue;
            var blankIconidxes = new List<int>(); var blankIcon = false;
            <ul class="@cls" role="menu" tabindex="0" data-sf-style="@BLOCKSTYLE @cmenuHidden" @onkeydown="@(async (e) => await KeyDownHandler(items[0], e, true))">
                @if (IsDevice && cls.Contains(SUBMENU) && parentItem != null)
                {
                    isSubMenuDevice = true;
                    <li class="@HEADER" @onclick="@(async (e) => await ItemClickHandler(parentItem, e, false, false, true))">
                        <span class="@PREVIOUS"></span>
                        @if (MenuTemplates != null && MenuTemplates.Template != null)
                            @(MenuTemplates.Template(parentItem))
                        else
                            @parentMenuItem?.Text
                    </li>
                }
                @for (var j = 0; j < items?.Count; j++)
                {
                    TValue menuItem = items[j];
                    ItemModel<TValue> item = BeforeItemCreation<TValue>(menuItem, j, itemClasses);
                    var liAttributes = GetAttributes(item.HtmlAttributes, "li");
                    @if (item.Separator)
                    {
                        <li role="separator" @attributes="@liAttributes"></li>
                    }
                    else
                    {
                        blankIcon = HandleBlankIcon(blankIconidxes, blankIcon, item, itemClasses, j);
                        <li role="menuitem" tabindex="-1" aria-label="@item.Text" @attributes="@liAttributes" @onmouseover="@(async () => await MouseOverHandler(menuItem))" @onmouseover:stopPropagation @onkeydown="@(async (e) => await KeyDownHandler(menuItem, e))" @onkeydown:stopPropagation @onclick="@(async (e) => await ItemClickHandler(menuItem, e))">
                            @if (MenuTemplates == null && !string.IsNullOrEmpty(item.Url))
                            {
                                var anchorAttributes = GetAttributes(item.HtmlAttributes, "anchor");
                                <a class="@URL" href="@item.Url" @attributes="@anchorAttributes">
                                    <div class="e-anchor-wrap">
                                        @if (!string.IsNullOrEmpty(item.IconCss))
                                        {
                                            <span class="@(ICON + SPACE + item.IconCss)"></span>
                                        }
                                        @item.Text
                                        @if (item.Items != null)
                                        {
                                            <span class="@CARET"></span>
                                        }
                                    </div>
                                </a>
                            }
                            else
                            {
                                @if (MenuTemplates != null && MenuTemplates.Template != null)
                                    @MenuTemplates.Template(menuItem)
                                else
                                {
                                    @if (!string.IsNullOrEmpty(item.IconCss))
                                    {
                                        <span class="@(ICON + SPACE + item.IconCss)"></span>
                                    }
                                    @item.Text
                                }
                                @if (item.Items != null)
                                {
                                    <span class="@CARET"></span>
                                }
                            }
                        </li>
                    }
                }
            </ul>
        }
    }
</div>
<div @ref="refElement" data-sf-style="display: none;"></div>

<CascadingValue Value="@this">
    @ChildContent
</CascadingValue>
