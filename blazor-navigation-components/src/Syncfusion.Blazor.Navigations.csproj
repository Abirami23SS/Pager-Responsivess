<Project Sdk="Microsoft.NET.Sdk.Razor">

 <PropertyGroup>
    <SignAssembly>true</SignAssembly>
	  <AssemblyOriginatorKeyFile>..\sf.snk</AssemblyOriginatorKeyFile>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <BlazorLinkOnBuild>false</BlazorLinkOnBuild>
    <LangVersion Condition="'$(TargetFramework)'=='net8.0'">12</LangVersion>
    <LangVersion Condition="'$(TargetFramework)'=='net9.0'">13</LangVersion>
    <LangVersion Condition="'$(TargetFramework)'=='net10.0'">14</LangVersion>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Version>100.2.1</Version>
    <FileVersion>100.2.1</FileVersion>
    <PackageId>Syncfusion.Blazor.Navigations</PackageId>
    <Title>Syncfusion Blazor Navigation Components</Title>
    <Company>Syncfusion Inc.</Company>
    <Authors>Syncfusion Inc.</Authors>
    <Product>Syncfusion Blazor Navigation Components</Product>
    <Copyright>Copyright 2001 - 2026 Syncfusion® Inc.</Copyright>
    <AssemblyName>Syncfusion.Blazor.Navigations</AssemblyName>
    <RootNamespace>Syncfusion.Blazor.Navigations</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://www.syncfusion.com/blazor-components/?utm_source=nuget&amp;utm_medium=listing</PackageProjectUrl>
    <PackageIcon>syncfusion_logo.png</PackageIcon>
    <PackageDescription>Syncfusion® Provides Blazor navigation and menu components for building interactive navigation structures. Includes Accordion, Sidebar, Tabs, Menu Bar, Context Menu, Toolbar, and Tree View with support for keyboard navigation, accessibility features, and customizable templates.</PackageDescription>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://blazor.syncfusion.com/documentation/release-notes/32.1.19/?utm_source=nuget&amp;utm_medium=listing</PackageReleaseNotes>
    <PackageTags>syncfusion;blazor;navigation;accordion;sidebar;tabs;menu;context-menu;toolbar;tree-view;menu-bar;keyboard-navigation;blazor-components;ui-components;accessibility;net8;net9;net10;</PackageTags>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
	<ItemGroup>
		<None Include="syncfusion_logo.png" Pack="true" PackagePath="\"/>
	</ItemGroup>
  <ItemGroup>
	<None Include="LICENSE.txt" Pack="true" PackagePath="\"/>
   </ItemGroup>
  <ItemGroup>
    <Content Update="*.razor">
      <Pack>false</Pack>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="Syncfusion.Blazor.Core" Version="34.2.2" />
      <PackageReference Include="Syncfusion.Blazor.Buttons" Version="34.2.2" />
      <PackageReference Include="Syncfusion.Blazor.Data" Version="34.2.2" />
      <PackageReference Include="Syncfusion.Blazor.Inputs" Version="34.2.2" />
      <PackageReference Include="Syncfusion.Blazor.Popups" Version="34.2.2" />
      <PackageReference Include="Syncfusion.Blazor.Lists" Version="34.2.2" />
      <PackageReference Include="Syncfusion.Blazor.Spinner" Version="34.2.2" />
      <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="34.2.2" />
  </ItemGroup>
</Project>