@page "/HeaderPositionTopWithInitContent/TabItem/NoIconTemplate"

@using Syncfusion.Blazor.Navigations

<SfTab LoadOn="ContentLoad.Init">
    <TabItems>
        <TabItem>
            <HeaderTemplate>
                <div>No Icon Header</div>
            </HeaderTemplate>
            <ChildContent>
                <TabHeader Text="No Icon Header"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div>Content</div>
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <HeaderTemplate>
                <div>Another No Icon</div>
            </HeaderTemplate>
            <ChildContent>
                <TabHeader Text="Another No Icon"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div>Another content</div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>