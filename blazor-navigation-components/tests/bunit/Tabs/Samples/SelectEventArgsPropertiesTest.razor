@using Syncfusion.Blazor.Navigations
@namespace Syncfusion.Blazor.Tests.Tabs.Samples

<div id="selectEventTest">
    <SfTab @ref="tab" @bind-SelectedItem="@selectedTabItem" Selecting="@OnTabSelecting" Selected="@OnTabSelected">
        <TabItems>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Tab 1"></TabHeader>
                </ChildContent>
                <ContentTemplate>Content 1</ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Tab 2"></TabHeader>
                </ChildContent>
                <ContentTemplate>Content 2</ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="Tab 3"></TabHeader>
                </ChildContent>
                <ContentTemplate>Content 3</ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>

    <span id="isSwiped">IsSwiped: @isSwiped</span>
    <span id="isInteracted">IsInteracted: @isInteracted</span>
    <span id="eventName">EventName: @eventName</span>
    <span id="preventFocus">PreventFocus: @preventFocus</span>
    <span id="previousIndex">PreviousIndex: @previousIndex</span>
    <span id="selectedIndex">SelectedIndex: @selectedIndex</span>
</div>

@code {
    public SfTab tab;
    public int selectedTabItem = 0;
    public bool isSwiped = false;
    public bool isInteracted = false;
    public string eventName = "Pending";
    public bool preventFocus = false;
    public int previousIndex = -1;
    public int selectedIndex = -1;

    private async Task OnTabSelecting(SelectingEventArgs args)
    {
        // Access and store all SelectingEventArgs getter properties
        isSwiped = args.IsSwiped;
        isInteracted = args.IsInteracted;
        eventName = args.Name ?? "Null";
        previousIndex = args.PreviousIndex;
        selectedIndex = args.SelectedIndex;

        await Task.CompletedTask;
    }

    private async Task OnTabSelected(SelectEventArgs args)
    {
        // Access and store all SelectEventArgs getter properties
        // This covers: IsSwiped, IsInteracted, Name, PreventFocus, PreviousIndex, SelectedIndex
        isSwiped = args.IsSwiped;
        isInteracted = args.IsInteracted;
        eventName = args.Name ?? "TabSelected";
        preventFocus = args.PreventFocus;
        previousIndex = args.PreviousIndex;
        selectedIndex = args.SelectedIndex;

        await Task.CompletedTask;
    }
}
