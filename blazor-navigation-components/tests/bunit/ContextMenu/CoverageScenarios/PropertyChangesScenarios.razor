@using Syncfusion.Blazor.Navigations

@namespace Syncfusion.Blazor.Tests.Navigations

<SfContextMenu @ref="ContextMenu" TValue="MenuItem" Target="@Target" Filter="@Filter">
    <MenuItems>
        <MenuItem Text="Cut"></MenuItem>
        <MenuItem Text="Copy"></MenuItem>
    </MenuItems>
</SfContextMenu>

@code {
    public SfContextMenu<MenuItem> ContextMenu { get; set; }
    
    [Parameter]
    public string Target { get; set; } = "#target";
    
    [Parameter]
    public string Filter { get; set; } = ".filter-target";
}
