<SfFixture @ref="fixture" Test="BasicRendering" Description="Pager Dropdown Value Change">
    <ComponentUnderTest>
        <SfPager TotalItemsCount="75" PageSizes=@pagesizes PageSize="5" NumericItemsCount="3" ShowAllInPageSizes="true" PageSizeChanging="OnPageSizeChanging" PageSizeChanged="OnPageSizeChanged"></SfPager>
    </ComponentUnderTest>
</SfFixture>


@code {
    SfFixture fixture { get; set; }
    public List<int> pagesizes = new List<int> { 0, 5, 10, 12, 20 };
    private async Task OnPageSizeChanging(PageSizeChangingArgs args)
    {
        await Task.CompletedTask;
    }
    private async Task OnPageSizeChanged(PageSizeChangedArgs args)
    {
        await Task.CompletedTask;
    }
    void BasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfPager>();
        var pageSize = cut.Instance.PageSize;
        Assert.Equal(5, pageSize);

        var pagerDropDown = cut.FindAll(".e-dropdownlist");
        pagerDropDown[0].MouseDown();
        Task.Delay(500).Wait();

        //Select 0 in dropdown and check whether the page size is changed to 0 or not.
        var changeDropdownValue = cut.Find("li[data-value=\"0\"]");
        changeDropdownValue.Click();
        Task.Delay(500).Wait();

        pagerDropDown[0].MouseDown();
        Task.Delay(500).Wait();

        var changeDropdownValue1 = cut.Find("li[data-value=\"10\"]");
        changeDropdownValue1.Click();
        Task.Delay(500).Wait();     
    }
}

<SfFixture @ref="fixture1" TestAsync="BasicRendering1" Description="Pager navigation via buttons">
    <ComponentUnderTest>
        <SfPager TotalItemsCount="75" PageSize="5" NumericItemsCount="3" PageChanging="OnPageChanging" PageChanged="OnPageChanged" ItemClick="OnItemClick"></SfPager>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture1 { get; set; }
    bool pageChangingInvoked2 = false;
    bool cancelNavigation2 = false;
    private async Task OnPageChanging(PageChangingEventArgs args)
    {
        pageChangingInvoked2 = true;
        args.Cancel = cancelNavigation2;
        await Task.CompletedTask;
    }

    private async Task OnPageChanged(PageChangedEventArgs args)
    {
        await Task.CompletedTask;
    }

    private async Task OnItemClick(PagerItemClickEventArgs args)
    {
        await Task.CompletedTask;
    }

    public async Task BasicRendering1(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfPager>();
        var pageSize = cut.Instance.PageSize;
        Assert.True(pageSize > 0, "Page size should be greater than 0");
        Assert.Equal(5, pageSize);
        //Go to Last page and check whether the current page is 15 or not.
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "FirstLastIconClickHandler", "NextPage", new MouseEventArgs());
        Assert.Equal(15, cut.Instance.CurrentPage);

        //Go to First page and check whether the current page is 1 or not.
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "FirstLastIconClickHandler", "PreviousPage", new MouseEventArgs());
        Assert.Equal(1, cut.Instance.CurrentPage);

        //Go to Next page and check whether the current page is 2 or not.
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "PreviousNextIconClickHandler", "NextPage", new MouseEventArgs());
        Assert.Equal(2, cut.Instance.CurrentPage);

        //Go to Previous page and check whether the current page is 1 or not.
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "PreviousNextIconClickHandler", "PreviousPage", new MouseEventArgs());
        Assert.Equal(1, cut.Instance.CurrentPage);

        //Go to Next set of page and check whether the current page is 4 or not.
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "EllipsisButtonClickHandler", "NextPage", new MouseEventArgs());
        Assert.Equal(4, cut.Instance.CurrentPage);

        //Go to Previous set of page and check whether the current page is 1 or not.
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "EllipsisButtonClickHandler", "PreviousPage", new MouseEventArgs());
        Assert.Equal(1, cut.Instance.CurrentPage);

        //Go to clicked page number and check whether the current page is 3 or not.
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ItemClickHandler", new MouseEventArgs(), 3);
        Assert.Equal(3, cut.Instance.CurrentPage);

        await cut.Instance.GoToPageAsync(3);
        Assert.Equal(3, cut.Instance.CurrentPage);

    }  
}


<SfFixture @ref="fixture2" TestAsync="BasicRendering2" Description="Pager navigation via API methods">
    <ComponentUnderTest>
        <SfPager TotalItemsCount="75" PageSize="5" NumericItemsCount="3"></SfPager>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture2 { get; set; }
    public async Task BasicRendering2(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfPager>();
        var pageSize = cut.Instance.PageSize;
        Assert.True(pageSize > 0, "Page size should be greater than 0");
        Assert.Equal(5, pageSize);

        //Navigates to the given page number in the Pager
        await cut.Instance.GoToPageAsync(3);
        Assert.Equal(3, cut.Instance.CurrentPage);

        //Navigates to the last page in the Pager
        await cut.Instance.GoToLastPageAsync();
        Assert.Equal(15, cut.Instance.CurrentPage);

        //Navigates to the first page in the Pager
        await cut.Instance.GoToFirstPageAsync();
        Assert.Equal(1, cut.Instance.CurrentPage);

        //Navigate to the next page in the Pager
        await cut.Instance.GoToNextPageAsync();
        Assert.Equal(2, cut.Instance.CurrentPage);

        //Navigate to the previous page in the Pager
        await cut.Instance.GoToPreviousPageAsync();
        Assert.Equal(1, cut.Instance.CurrentPage);

        //Used to update the page size of the Pager
        await cut.Instance.UpdatePageSizeAsync(6);
        Assert.Equal(6, cut.Instance.PageSize);

        // Used to update the number of numeric elements shown in the Pager component
        await cut.Instance.UpdateNumericItemsCountAsync(4);
        Assert.Equal(4, cut.Instance.NumericItemsCount);
        await cut.Instance.RefreshAsync();
    }
}

