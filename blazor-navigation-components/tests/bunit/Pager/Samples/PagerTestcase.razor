<SfFixture @ref="fixture4" TestAsync="BasicRendering4" Description="Pager Keyboard Navigation">
    <ComponentUnderTest>
        <SfPager TotalItemsCount="75" PageSize="5" NumericItemsCount="3"></SfPager>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture4 { get; set; }
    public async Task BasicRendering4(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfPager>();
        var pageSize = cut.Instance.PageSize;
        Assert.True(pageSize > 0, "Page size should be greater than 0");
        Assert.Equal(5, pageSize);
        var numericItem = cut.FindAll(".e-numericitem");
        numericItem[1].Click();
        await Task.Delay(1000);

        //Navigate to the next page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "Tab" }, 0, "" );
        await Task.Delay(1000);
        Assert.Equal(2, cut.Instance.CurrentPage);

        //Navigate to the next page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "ArrowRight" }, 0, "" );
        Assert.Equal(3, cut.Instance.CurrentPage);

        //Navigate to the previous page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "ArrowLeft" }, 0, "" );
        Assert.Equal(2, cut.Instance.CurrentPage);

        //Navigate to the first page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "Home" }, 0, "" );
        Assert.Equal(1, cut.Instance.CurrentPage);

        //Navigate to the last page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "End" }, 0, "" );
        Assert.Equal(15, cut.Instance.CurrentPage);

        //Navigate to previous set of page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "AltPageUp" }, 0, "" );

        //Navigate to next set of page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "AltPageDown" }, 0, "" );

        //Navigate to the next page in the Pager
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "Enter" }, 0, "" );

        await PagerReflection.InvokeAsyncMethod(cut.Instance, "EllipsisButtonClickHandler", "NextPage", new MouseEventArgs());
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "Enter" }, 0, "" );

        await PagerReflection.InvokeAsyncMethod(cut.Instance, "EllipsisButtonClickHandler", "Previous", new MouseEventArgs());
        await PagerReflection.InvokeAsyncMethod(cut.Instance, "ProcessPagerKeyDown", new KeyboardEventArgs { Key = "Enter" }, 0, "" );
    }
}

