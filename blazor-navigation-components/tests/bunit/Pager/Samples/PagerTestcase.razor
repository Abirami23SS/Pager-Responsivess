<SfFixture @ref="fixture7" TestAsync="BasicRendering7" Description="Item Click Handler">
    <ComponentUnderTest>
        <SfPager TotalItemsCount="75" PageSize="5" NumericItemsCount="3" ShowPagerMessage="true"></SfPager>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture7 { get; set; }
    public async Task BasicRendering7(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfPager>();
        var pageSize = cut.Instance.PageSize;
        Assert.True(pageSize > 0, "Page size should be greater than 0");
        Assert.Equal(5, pageSize);
        //Item click handler will be triggered when we click on the next icon in the pager.
        var nextIcon = cut.FindAll(".e-icon-next");
        nextIcon[0].Click();

        //Item click handler will be triggered when we click on the last icon in the pager.
        var lastIcon = cut.FindAll(".e-icon-last");
        lastIcon[0].Click();

        //Item click handler will be triggered when we click on the previous icon in the pager.
        var previousIcon = cut.FindAll(".e-icon-prev");
        previousIcon[0].Click();
        
        //Item click handler will be triggered when we click on the first icon in the pager.
        var firstIcon = cut.FindAll(".e-icon-first");
        firstIcon[0].Click();

        //Item click handler will be triggered when we click on the next set of page in the pager.
        var rightDots = cut.FindAll(".e-np.e-spacing");
        rightDots[0].Click();

        //Item click handler will be triggered when we click on the previous set of page in the pager.
        var leftDots = cut.FindAll(".e-pp.e-spacing");
        leftDots[0].Click();       
    }
}

<SfFixture @ref="fixture8" TestAsync="UpdatePropertyMethod" Description="UpdateProperty Method - Property Binding Coverage">
    <ComponentUnderTest>
        <SfPager TotalItemsCount="8" PageSize="5" NumericItemsCount="3"></SfPager>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture8 { get; set; }
    public async Task UpdatePropertyMethod(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfPager>();

        // Test 1: UpdateProperty - When public and private values are equal
        // Should return publicValue without any changes to directParameters
        object result1 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "CurrentPage", 5, 5);
        Assert.Equal(5, result1);

        // Test 2: UpdateProperty - When public and private values differ but not rerendering
        // Should return privateValue since IsRerendering is false and IsRendered is true
        object result2 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "CurrentPage", 5, 3);
        Assert.Equal(3, result2);

        // Test 3: UpdateProperty - Different property names
        // Test with PageSize property
        object result3 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "PageSize", 10, 10);
        Assert.Equal(10, result3);

        // Test 4: UpdateProperty - NumericItemsCount property with different values
        object result4 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "NumericItemsCount", 4, 3);
        Assert.NotNull(result4);

        // Test 5: UpdateProperty - With string property value
        object result5 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "ExternalMessage", "Test Message", "Old Message");
        Assert.NotNull(result5);

        // Test 6: UpdateProperty - With null values
        object result6 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "ExternalMessage", null, "Old Value");
        Assert.NotNull(result6);

        // Test 7: UpdateProperty - Multiple calls with same property should update correctly
        object result7a = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "CurrentPage", 7, 6);
        object result7b = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "CurrentPage", 8, 7);
        Assert.NotNull(result7a);
        Assert.NotNull(result7b);

        // Test 8: UpdateProperty - With zero values
        object result8 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "CurrentPage", 0, 1);
        Assert.Equal(1, result8);


        // Test 9: UpdateProperty - PropertyChanges dictionary should be updated
        // Call UpdateProperty and verify result is returned
        object result9 = PagerReflection.InvokeMethod<object>(cut.Instance, "UpdateProperty", "PageSize", 15, 5);
        Assert.NotNull(result9);

        await Task.CompletedTask;
    }
}

