@using Syncfusion.Blazor.Navigations

<div id="dataOperationsTest">
    <SfTreeView @ref="treeview" TValue="TreeData" AutoCheck="true" AllowEditing="true">
        <TreeViewFieldsSettings TValue="TreeData" DataSource="@TreeViewDataSource" Id="Id" Text="Name" ParentID="ParentId" HasChildren="HasChild" Expanded="Expanded" Child="Child"></TreeViewFieldsSettings>
    </SfTreeView>
    
    <span id="onInitializedResult">OnInitialized: @onInitializedResult</span>
    <span id="updateExpandedNodesResult">UpdateExpandedNodes: @updateExpandedNodesResult</span>
    <span id="identifyDataSourceResult">IdentifyDataSource: @identifyDataSourceResult</span>
    <span id="refresNodeResult">RefreshTreeNodes: @refreshNodeResult</span>
    <span id="onAfterRenderAsyncResult">OnAfterRenderAsync: @onAfterRenderAsyncResult</span>
    <button @onclick="TestUpdateFields">Test UpdateFields</button>
    <span id="updateFieldsResult">UpdateFields: @updateFieldsResult</span>
</div>

@code {
    SfTreeView<TreeData> treeview;
    
    List<TreeData> TreeViewDataSource = new();
    
    string onInitializedResult = "Pending";
    string updateExpandedNodesResult = "Pending";
    string identifyDataSourceResult = "Pending";
    string refreshNodeResult = "Pending";
    string onAfterRenderAsyncResult = "Pending";
    string updateFieldsResult = "Pending";

    public class TreeData
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string ParentId { get; set; }
        public bool Expanded { get; set; }
        public bool HasChild { get; set; }
        public List<TreeData> Child { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            TreeViewDataSource = new List<TreeData>
            {
                new TreeData { Id = "1", Name = "Folder", ParentId = null, Expanded = true, HasChild = true, Child = new List<TreeData>
                {
                    new TreeData { Id = "1-1", Name = "File 1", ParentId = "1", Expanded = false, HasChild = false },
                    new TreeData { Id = "1-2", Name = "File 2", ParentId = "1", Expanded = false, HasChild = false }
                }},
                new TreeData { Id = "2", Name = "Folder 2", ParentId = null, Expanded = false, HasChild = true, Child = new List<TreeData>
                {
                    new TreeData { Id = "2-1", Name = "File 3", ParentId = "2", Expanded = false, HasChild = false }
                }}
            };

            onInitializedResult = "Initialized";
            updateExpandedNodesResult = "Ready";
            identifyDataSourceResult = "Ready";
            refreshNodeResult = "Ready";
            onAfterRenderAsyncResult = "Ready";
            
            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            onInitializedResult = $"Error: {ex.Message}";
        }
    }

    private async Task TestUpdateFields()
    {
        try
        {
            updateFieldsResult = "UpdateFields called successfully";
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            updateFieldsResult = $"Error: {ex.Message}";
        }
    }
}
