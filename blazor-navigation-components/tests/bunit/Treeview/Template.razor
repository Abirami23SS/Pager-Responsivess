        var rootEle = treeview.Find(".e-treeview");

        var liElements = rootEle.QuerySelectorAll(".e-badge-primary");
        Assert.True(10 == liElements.Length, "Total number of Li items");

        treeview.SetParametersAndRender(("CheckedNodes", new string[] { "NA", "AF" }));


        var liElements_1 = treeview.FindAll("li");
        var liLength = treeview.FindAll("li").Count;
        for (var i = 0; i < liLength; i++)
        {
            var checkboEle = liElements_1[i].QuerySelector(".e-text-content .e-checkbox-wrapper .e-check");
            if (i < 5)
            {
                Assert.True(checkboEle != null, "AutoCheck property is working properly");
