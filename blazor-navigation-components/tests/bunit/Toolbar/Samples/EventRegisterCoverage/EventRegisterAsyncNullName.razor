@namespace Syncfusion.Blazor.Tests.Toolbar.Samples.EventRegisterCoverage
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Navigations.Internal

@* This component tests the branch where Name is null but Parent is not null *@
<SfToolbar>
    <EventRegisterAsync Name="@nullName" Handler="@Handler"></EventRegisterAsync>
    <ToolbarItems>
        <ToolbarItem Text="Cut"></ToolbarItem>
    </ToolbarItems>
</SfToolbar>

@code {
    private string nullName = null;
    private Func<Task, object, Task> Handler = async (task, args) => { await Task.CompletedTask; };
}