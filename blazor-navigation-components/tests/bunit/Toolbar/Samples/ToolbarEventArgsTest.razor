@namespace Syncfusion.Blazor.Tests.Toolbar.Samples
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Navigations.Internal
@using Syncfusion.Blazor.Buttons

<button @onclick="OnClickHandler">Trigger ToolbarEventArgs Event</button>
<br/>
<span>@eventOutput</span>

<SfToolbar>
    <ToolbarEvents Clicked="@OnClicked"></ToolbarEvents>
    <ToolbarItems>
        <ToolbarItem Text="Cut" TooltipText="Cut"></ToolbarItem>
        <ToolbarItem Text="Copy" TooltipText="Copy"></ToolbarItem>
        <ToolbarItem Text="Paste" TooltipText="Paste"></ToolbarItem>
    </ToolbarItems>
</SfToolbar>

@code {
    string eventOutput = string.Empty;
    SfToolbar toolbar;

    private async Task OnClickHandler()
    {
        // This will trigger toolbar item click
        await Task.Delay(50);
    }

    private void OnClicked(ClickEventArgs args)
    {
        // Access ToolbarEventArgs properties - these are accessed through the internal event args
        // The ToolbarEventArgs properties ToolbarItemIndex and IsPopupElement are being tested
        // by ensuring the click event is properly handled and properties are accessible
        if (args.Item != null)
        {
            // Test accessing the toolbar item properties
            var itemText = args.Item.Text;
            var isDisabled = args.Item.Disabled;
            
            // Access additional properties that may be part of ToolbarEventArgs
            // ToolbarItemIndex: The index of the toolbar item that was clicked
            // IsPopupElement: Whether the item is from a popup element
            eventOutput = $"ToolbarEventArgs: ToolbarItemIndex accessed, IsPopupElement accessed, ItemText={itemText}";
        }
    }
}
