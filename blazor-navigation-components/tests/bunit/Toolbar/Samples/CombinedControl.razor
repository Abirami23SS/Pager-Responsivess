@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs 
@using Syncfusion.Blazor.Navigations

<SfButton id="ButtonId" @onclick="btnClick">Dropdown Click</SfButton>

<SfToolbar Width="650px">
    <ToolbarItems>
        <ToolbarItem>
            <Template>
                <SfCheckBox @bind-Checked="@Checked" Label="Checkbox"></SfCheckBox>
            </Template>
        </ToolbarItem>
        <ToolbarItem>
            <Template>
                <SfDropDownList @ref="@DropdownRef" TValue="string" TItem="Games" Width="200px" PopupHeight="350px" PopupWidth="350px" Placeholder="Select a game" DataSource="@LocalData">
                    <DropDownListFieldSettings Value="ID" Text="Text"></DropDownListFieldSettings>
                </SfDropDownList>
            </Template>
        </ToolbarItem>
        <ToolbarItem>
            <Template>
                <SfRadioButton @bind-Checked="@Checked" Label="Radio button"></SfRadioButton>
            </Template>
        </ToolbarItem>
        <ToolbarItem>
            <Template>
                <SfTextBox Placeholder="Type something" Width="200px"></SfTextBox>
            </Template>
        </ToolbarItem>
    </ToolbarItems>
</SfToolbar>
@code{
    public SfDropDownList<string, Games> DropdownRef;
    private bool Checked { get; set; }
    List<Games> LocalData = new List<Games> {
        new Games() { ID= "Game1", Text= "American Football" },
        new Games() { ID= "Game2", Text= "Badminton" },
        new Games() { ID= "Game3", Text= "Basketball" },
        new Games() { ID= "Game4", Text= "Cricket" },
        new Games() { ID= "Game5", Text= "Football" },
        new Games() { ID= "Game6", Text= "Golf" },
        new Games() { ID= "Game7", Text= "Hockey" },
        new Games() { ID= "Game8", Text= "Rugby"},
        new Games() { ID= "Game9", Text= "Snooker" },
        new Games() { ID= "Game10", Text= "Tennis"}
    };

    private async Task btnClick()
    {
       await DropdownRef.ShowPopupAsync();
    }

    public class Games
    {
        public string ID { get; set; }
        public string Text { get; set; }
    }
}