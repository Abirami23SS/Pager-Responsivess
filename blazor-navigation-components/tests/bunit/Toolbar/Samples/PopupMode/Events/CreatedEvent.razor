@page "/PopupMode/Events/CreatedEvent"

@using Syncfusion.Blazor.Navigations

<br />
<span>@output</span>
<br />
<SfToolbar OverflowMode="OverflowMode.Popup">
    <ToolbarEvents Created="ToolbarCreated">
    </ToolbarEvents>
    <ToolbarItems>
        <ToolbarItem Text="Cut"></ToolbarItem>
        <ToolbarItem Text="Copy"></ToolbarItem>
        <ToolbarItem Text="Paste"></ToolbarItem>
    </ToolbarItems>
</SfToolbar>

@code{

    private string output = "";

    /* Events */

    public void ToolbarCreated()
    {
        this.output = this.output + "Toolbar created event testing";
        StateHasChanged();
    }
}