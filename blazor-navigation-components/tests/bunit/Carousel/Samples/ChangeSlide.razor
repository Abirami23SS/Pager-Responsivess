@page "/Samples/Carousel/ChangeSlide"

@using Syncfusion.Blazor.Navigations

<div class="control-container">
    <SfCarousel @ref="@carousel" ID="CarouselPersistence" EnablePersistence="true" AutoPlay="false">
        <CarouselItem>
            <div class="slide-content">Slide 1</div>
        </CarouselItem>
        <CarouselItem>
            <div class="slide-content">Slide 2</div>
        </CarouselItem>
        <CarouselItem>
            <div class="slide-content">Slide 3</div>
        </CarouselItem>
        <CarouselItem>
            <div class="slide-content">Slide 4</div>
        </CarouselItem>
        <CarouselItem>
            <div class="slide-content">Slide 5</div>
        </CarouselItem>
    </SfCarousel>
</div>

@code {
    public SfCarousel carousel;
    public async Task previousSlideChange()
    {
        await carousel.ChangeSlide("Previous");
    }
    public async Task nextSlideChange()
    {
        await carousel.ChangeSlide("Next");
    }
}
<style>
    .control-container {
        background-color: #adb5bd;
        height: 300px;
        margin: 0 auto;
        width: 500px;
    }

    .e-carousel .slide-content {
        align-items: center;
        display: flex;
        font-size: 1.25rem;
        height: 100%;
        justify-content: center;
    }
</style>