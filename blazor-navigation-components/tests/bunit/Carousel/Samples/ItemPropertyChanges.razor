@page "/Samples/Carousel/ItemPropertyChanges"

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs

<SfDropDownList TValue="int" TItem="DropDownData" @bind-Value="@OddItemInterval" DataSource="@intervalData" FloatLabelType="FloatLabelType.Always" Placeholder="Interval - 1 & 3" Width="125px">
    <DropDownListFieldSettings Text="Name" Value="Interval"></DropDownListFieldSettings>
</SfDropDownList>

<SfDropDownList TValue="int" TItem="DropDownData" @bind-Value="@EvenItemInterval" DataSource="@intervalData" FloatLabelType="FloatLabelType.Always" Placeholder="Interval 2 & 4" Width="125px">
    <DropDownListFieldSettings Text="Name" Value="Interval"></DropDownListFieldSettings>
</SfDropDownList>

<SfDropDownList TValue="string" TItem="DropDownData" @bind-Value="@OddItemCSS" DataSource="@cssData" FloatLabelType="FloatLabelType.Always" Placeholder="Css Class - 1 & 3" Width="125px">
    <DropDownListFieldSettings Text="Name" Value="Value"></DropDownListFieldSettings>
</SfDropDownList>

<SfDropDownList TValue="string" TItem="DropDownData" @bind-Value="@EvenItemCSS" DataSource="@cssData" FloatLabelType="FloatLabelType.Always" Placeholder="Css Class - 2 & 4" Width="125px">
    <DropDownListFieldSettings Text="Name" Value="Value"></DropDownListFieldSettings>
</SfDropDownList>

<div class="carousel-container">
    <SfCarousel>
        <CarouselItem Interval="@OddItemInterval" CssClass="@("e-carousel-item-" + OddItemCSS)">
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/san-francisco.jpg" alt="san-francisco" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
        <CarouselItem Interval="@EvenItemInterval" CssClass="@("e-carousel-item-" + EvenItemCSS)">
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/london.jpg" alt="london" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
        <CarouselItem Interval="@OddItemInterval" CssClass="@("e-carousel-item-" + OddItemCSS)">
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/tokyo.jpg" alt="tokyo" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
        <CarouselItem Interval="@EvenItemInterval" CssClass="@("e-carousel-item-" + EvenItemCSS)">
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/moscow.jpg" alt="moscow" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
    </SfCarousel>
</div>

<style>
    .carousel-container {
        margin: 0 auto 2em;
        max-width: 555px;
        height: 373px;
        background-color: #f5f5f5;
        margin-top: 15px;
    }

    .property-checkbox {
        margin-right: 15px;
        margin-bottom: 20px;
    }

    .e-carousel .e-carousel-item.e-carousel-item-light {
        border: 5px solid yellow;
    }

    .e-carousel .e-carousel-item.e-carousel-item-dark {
        border: 5px solid red;
    }

    .e-carousel .e-carousel-item.e-carousel-item-transparent {
        border: 3px solid transparent;
    }
</style>

@code {
    public int OddItemInterval { get; set; } = 5000;
    public int EvenItemInterval { get; set; } = 3000;
    public string OddItemCSS { get; set; } = "transparent";
    public string EvenItemCSS { get; set; } = "transparent";

    List<DropDownData> intervalData = new List<DropDownData>()
    {
        new DropDownData { Name = "2000", Interval = 2000 },
        new DropDownData { Name = "3000", Interval = 3000 },
        new DropDownData { Name = "5000", Interval = 5000 },
        new DropDownData { Name = "8000", Interval = 8000 }
    };
    List<DropDownData> cssData = new List<DropDownData>()
    {
        new DropDownData { Name = "Transparent", Value = "transparent" },
        new DropDownData { Name = "Yellow", Value = "light" },
        new DropDownData { Name = "Red", Value = "dark" }
    };
    public class DropDownData
    {
        public string Name { get; set; }
        public string Value { get; set; }
        public int Interval { get; set; }
    }
}