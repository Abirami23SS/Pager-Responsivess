@page "/Samples/Carousel/CustomAnimation"

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs

<SfDropDownList TValue="string" TItem="DropDownData" @bind-Value="@customEffect" DataSource="@customEffectData" FloatLabelType="FloatLabelType.Always" Placeholder="Custom Effect" Width="200px">
    <DropDownListFieldSettings Text="Name" Value="Value"></DropDownListFieldSettings>
</SfDropDownList>

<div class="carousel-container">
    <SfCarousel AnimationEffect="CarouselAnimationEffect.Custom" CssClass="@customEffect" ButtonsVisibility="CarouselButtonVisibility.Hidden">
        <CarouselItem>
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/cardinal.png" alt="cardinal" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
        <CarouselItem>
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/hunei.png" alt="hunei" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
        <CarouselItem>
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/costa-rica.png" alt="costa-rica" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
        <CarouselItem>
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/kaohsiung.png" alt="kaohsiung" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
        <CarouselItem>
            <figure class="img-container">
                <img src="https://ej2.syncfusion.com/demos/src/carousel/images/bee-eater.png" alt="bee-eater" style="height:100%;width:100%;" />
            </figure>
        </CarouselItem>
    </SfCarousel>
</div>

@code{
    string customEffect = "parallax";
    private List<DropDownData> customEffectData { get; set; } = new List<DropDownData>()
    {
        new DropDownData { Name = "Bounce", Value = "bounce"  },
        new DropDownData { Name = "Flip", Value = "flip" },
        new DropDownData { Name = "Parallax", Value = "parallax" },
        new DropDownData { Name = "Zoom", Value = "zoom" }
    };
    public class DropDownData
    {
        public string Name { get; set; }
        public string Value { get; set; }
    }
}

<style>
    .carousel-container {
        background-color: #f8f9fa;
        border: 1px solid #e5e5e5;
        border-radius: 1rem;
        margin: 0 auto;
        padding: 2rem;
        width: 566px;
        height: 366px;
        margin-top: 15px;
    }

    .e-carousel-custom-animation.bounce .e-carousel-item,
    .e-carousel-custom-animation.flip .e-carousel-item,
    .e-carousel-custom-animation.parallax .e-carousel-item,
    .e-carousel-custom-animation.zoom .e-carousel-item {
        transition: transform 1s ease-in-out;
    }

    /* Parallax animation */
    .e-carousel-custom-animation.parallax .e-carousel-item.e-next {
        animation: ParallaxIn 1s ease-in-out;
        animation-delay: 1s;
    }

    .e-carousel-custom-animation.parallax .e-carousel-item.e-prev {
        animation: ParallaxOut 1s ease-in-out;
    }

    @@keyframes ParallaxIn {
        from {
            opacity: 0;
            transform: scale(0) translateY(100%);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes ParallaxOut {
        from {
            opacity: 1;
            transform: scale(1) translateY(0);
        }

        to {
            opacity: 0;
            transform: scale(0) translateY(-100%);
        }
    }

    /* Bounce, Flip and Zoom animation has been derived from https://animate.style/ CSS library */

    /* Bounce animation */
    .e-carousel-custom-animation.bounce .e-carousel-item.e-next {
        animation: bounceInUp 1s ease-in-out;
        animation-delay: 1s;
    }

    .e-carousel-custom-animation.bounce .e-carousel-item.e-prev {
        animation: bounceOutUp 1s ease-in-out;
    }

    @@keyframes bounceInUp {
        0%, 60%, 75%, 90%, 100% {
            -webkit-animation-timing-function: cubic-bezier(.215,.61,.355,1);
            animation-timing-function: cubic-bezier(.215,.61,.355,1);
        }
        0% {
            opacity: 0;
            -webkit-transform: translate3d(0,3000px,0) scaleY(5);
            transform: translate3d(0,3000px,0) scaleY(5);
        }
        60% {
            opacity: 1;
            -webkit-transform: translate3d(0,-20px,0) scaleY(.9);
            transform: translate3d(0,-20px,0) scaleY(.9);
        }
        75% {
            -webkit-transform: translate3d(0,10px,0) scaleY(.95);
            transform: translate3d(0,10px,0) scaleY(.95);
        }
        90% {
            -webkit-transform: translate3d(0,-5px,0) scaleY(.985);
            transform: translate3d(0,-5px,0) scaleY(.985);
        }
        100% {
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
        }
    }

    @@keyframes bounceOutUp {
        20% {
            -webkit-transform: translate3d(0,-10px,0) scaleY(.985);
            transform: translate3d(0,-10px,0) scaleY(.985);
        }

        40%, 45% {
            opacity: 1;
            -webkit-transform: translate3d(0,20px,0) scaleY(.9);
            transform: translate3d(0,20px,0) scaleY(.9);
        }

        100% {
            opacity: 0;
            -webkit-transform: translate3d(0,-2000px,0) scaleY(3);
            transform: translate3d(0,-2000px,0) scaleY(3);
        }
    }

    /* Flip animation */
    .e-carousel-custom-animation.flip .e-carousel-item.e-next {
        animation: flipInY 1s ease-in-out;
        animation-delay: 1s;
    }

    .e-carousel-custom-animation.flip .e-carousel-item.e-prev {
        animation: flipOutY 1s ease-in-out;
    }

    @@keyframes flipInY {
        0% {
            -webkit-transform: perspective(400px) rotateY(90deg);
            transform: perspective(400px) rotateY(90deg);
            -webkit-animation-timing-function: ease-in;
            animation-timing-function: ease-in;
            opacity: 0;
        }

        40% {
            -webkit-transform: perspective(400px) rotateY(-20deg);
            transform: perspective(400px) rotateY(-20deg);
            -webkit-animation-timing-function: ease-in;
            animation-timing-function: ease-in;
        }

        60% {
            opacity: 1;
            -webkit-transform: perspective(400px) rotateY(10deg);
            transform: perspective(400px) rotateY(10deg);
        }

        80% {
            -webkit-transform: perspective(400px) rotateY(-5deg);
            transform: perspective(400px) rotateY(-5deg);
        }

        100% {
            -webkit-transform: perspective(400px);
            transform: perspective(400px);
        }
    }

    @@keyframes flipOutY {
        0% {
            -webkit-transform: perspective(400px);
            transform: perspective(400px);
        }

        30% {
            -webkit-transform: perspective(400px) rotateY(-15deg);
            transform: perspective(400px) rotateY(-15deg);
            opacity: 1;
        }

        100% {
            -webkit-transform: perspective(400px) rotateY(90deg);
            transform: perspective(400px) rotateY(90deg);
            opacity: 0;
        }
    }

    /* Zoom animation */
    .e-carousel-custom-animation.zoom .e-carousel-item.e-next {
        animation: zoomInLeft 1s ease-in-out;
        animation-delay: 1s;
    }

    .e-carousel-custom-animation.zoom .e-carousel-item.e-prev {
        animation: zoomOutRight 1s ease-in-out;
    }

    @@keyframes zoomInLeft {
        0% {
            opacity: 0;
            -webkit-transform: scale3d(.1,.1,.1) translate3d(-1000px,0,0);
            transform: scale3d(.1,.1,.1) translate3d(-1000px,0,0);
            -webkit-animation-timing-function: cubic-bezier(.55,.055,.675,.19);
            animation-timing-function: cubic-bezier(.55,.055,.675,.19);
        }

        60% {
            opacity: 1;
            -webkit-transform: scale3d(.475,.475,.475) translate3d(10px,0,0);
            transform: scale3d(.475,.475,.475) translate3d(10px,0,0);
            -webkit-animation-timing-function: cubic-bezier(.175,.885,.32,1);
            animation-timing-function: cubic-bezier(.175,.885,.32,1);
        }
    }

    @@keyframes zoomOutRight {
        40% {
            opacity: 1;
            -webkit-transform: scale3d(.475,.475,.475) translate3d(-42px,0,0);
            transform: scale3d(.475,.475,.475) translate3d(-42px,0,0);
        }

        100% {
            opacity: 0;
            -webkit-transform: scale(.1) translate3d(2000px,0,0);
            transform: scale(.1) translate3d(2000px,0,0);
        }
    }
</style>