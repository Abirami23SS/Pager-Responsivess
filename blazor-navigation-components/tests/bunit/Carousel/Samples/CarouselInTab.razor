@page "/Samples/Carousel/CarouselInTab"

@using Syncfusion.Blazor.Navigations

<SfTab SelectedItem="@SelectedTab">
    <TabItems>
        <TabItem>
            <HeaderTemplate>
                <div>Carousel Sample-1</div>
            </HeaderTemplate>
            <ContentTemplate>
                <div class="control-container-1">
                    <SfCarousel CssClass="carousel-1">
                        <CarouselItem>
                            <div class="slide-content">Slide 1</div>
                        </CarouselItem>
                        <CarouselItem>
                            <div class="slide-content">Slide 2</div>
                        </CarouselItem>
                        <CarouselItem>
                            <div class="slide-content">Slide 3</div>
                        </CarouselItem>
                    </SfCarousel>
                </div>
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <HeaderTemplate>
                <div>Carousel Sample-2</div>
            </HeaderTemplate>
            <ContentTemplate>
                <div class="control-container-2">
                    <SfCarousel CssClass="carousel-2" AutoPlay="false">
                        <CarouselItem>
                            <div class="slide-content">Slide 4</div>
                        </CarouselItem>
                        <CarouselItem>
                            <div class="slide-content">Slide 5</div>
                        </CarouselItem>
                        <CarouselItem>
                            <div class="slide-content">Slide 6</div>
                        </CarouselItem>
                    </SfCarousel>
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

<style>
    .e-tab .control-container-1,
    .e-tab .control-container-2 {
        height: 300px;
        margin: 0 auto;
        width: 500px;
    }
    .control-container-1,
    .carousel-1 .e-active {
        background-color: #adb5bd;
    }
    .control-container-2,
    .carousel-2 .e-active {
        background-color: goldenrod;
    }
    .e-carousel .slide-content {
        align-items: center;
        display: flex;
        font-size: 1.25rem;
        height: 100%;
        justify-content: center;
    }
</style>

@code {
    public int SelectedTab = 0;
}