@page "/Samples/Carousel/DataBinding"

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs

<SfButton OnClick="AddItem" Content="AddItem"></SfButton>
<SfButton OnClick="AddItemRange" Content="AddRange"></SfButton>
<SfButton OnClick="AddItemWithIndex" Content="AddItem in specified Index"></SfButton>
<SfButton OnClick="RemoveItem" Content="RemoveItem"></SfButton>
<SfButton OnClick="RemoveItemRange" Content="RemoveRange"></SfButton>
<SfButton OnClick="RemoveItemWithIndex" Content="RemoveItem in specified Index"></SfButton>
<SfButton OnClick="DisposeCarousel" Content="DisposeCarousel"></SfButton>

<SfCheckBox @bind-Checked="showItem" Label="Show/Hide item in specified index"></SfCheckBox>

<SfNumericTextBox @bind-Value="@CarouselIndex" Min="0" Max="@maxValue" FloatLabelType="FloatLabelType.Always" Placeholder="Select Carousel Index" Width="200px"></SfNumericTextBox>

@if (renderCarousel)
{
    <div class="carousel-sample">
        <SfCarousel CssClass="db-carousel" AutoPlay="false">
            @{
                for (int i = 0; i < FrameworkData.Count; i++)
                {
                    FrameworkDetails framework = FrameworkData[i];
                    @if (!showItem && CarouselIndex == i)
                    {
                        continue;
                    }
                    <CarouselItem>
                        <div class="card">
                            <img src="@("https://ej2.syncfusion.com/demos/src/carousel/images/" + framework.ImageName)" class="card-img-top" alt=@framework.Title style="height:210px;width:100%;" />
                            <div class="card-body" style="padding:1rem;">
                                <h5 class="card-title">@framework.Title</h5>
                                <p class="card-text">@framework.Content</p>
                            </div>
                        </div>
                    </CarouselItem>
                }
            }
        </SfCarousel>
    </div>
}

@code {
    private bool showItem = true;
    private bool renderCarousel = true;
    public int CarouselIndex = 0;
    int maxValue = 3;
    List<FrameworkDetails> FrameworkData = new List<FrameworkDetails>() {
        new FrameworkDetails {
            ID = 1,
            Title = "San Francisco",
            Content = "San Francisco, officially the City and County of San Francisco, is a cultural, commercial, and financial center in the U.S. state of California. Located in Northern California, San Francisco is the 17th most populous city proper in the United States, and the fourth most populous in California.",
            ImageName = "san-francisco.jpg",
            URL= "https://en.wikipedia.org/wiki/San_Francisco"
        },
        new FrameworkDetails {
            ID = 2,
            Title = "London",
            Content = "London, the capital of England and the United Kingdom, is a 21st-century city with history stretching back to Roman times. At its centre stand the imposing Houses of Parliament, the iconic 'Big Ben' clock tower and Westminster Abbey, site of British monarch coronations.",
            ImageName = "london.jpg",
            URL= "https://en.wikipedia.org/wiki/London"
        },
        new FrameworkDetails {
            ID = 3,
            Title = "Tokyo",
            Content = "Tokyo, Japan's busy capital, mixes the ultramodern and the traditional, from neon-lit skyscrapers to historic temples. The opulent Meiji Shinto Shrine is known for its towering gate and surrounding woods. The Imperial Palace sits amid large public gardens.",
            ImageName = "tokyo.jpg",
            URL= "https://en.wikipedia.org/wiki/Tokyo"
        },
        new FrameworkDetails {
            ID = 4,
            Title = "Moscow",
            Content = "Moscow, on the Moskva River in western Russia, is the nation's cosmopolitan capital. In its historic core is the Kremlin, a complex that's home to the president and tsarist treasures in the Armoury. Outside its walls is Red Square, Russia`s symbolic center.",
            ImageName = "moscow.jpg",
            URL= "https://en.wikipedia.org/wiki/Moscow"
        }
    };
    private void AddItem()
    {
        int count = FrameworkData.Count;
        FrameworkDetails data = new FrameworkDetails
        {
            ID = count,
            Title = "San Francisco",
            Content = "San Francisco, officially the City and County of San Francisco, is a cultural, commercial, and financial center in the U.S. state of California. Located in Northern California, San Francisco is the 17th most populous city proper in the United States, and the fourth most populous in California.",
            ImageName = "san-francisco.jpg",
            URL = "https://en.wikipedia.org/wiki/San_Francisco"
        };
        FrameworkData.Add(data);
        maxValue = FrameworkData.Count - 1;
    }
    private void AddItemRange()
    {
        int count = FrameworkData.Count;
        List<FrameworkDetails> data = new List<FrameworkDetails>()
        {
            new FrameworkDetails
            {
                ID = count,
                Title = "London",
                Content = "London, the capital of England and the United Kingdom, is a 21st-century city with history stretching back to Roman times. At its centre stand the imposing Houses of Parliament, the iconic 'Big Ben' clock tower and Westminster Abbey, site of British monarch coronations.",
                ImageName = "london.jpg",
                URL = "https://en.wikipedia.org/wiki/London"
            },
            new FrameworkDetails
            {
                ID = count + 1,
                Title = "Tokyo",
                Content = "Tokyo, Japan's busy capital, mixes the ultramodern and the traditional, from neon-lit skyscrapers to historic temples. The opulent Meiji Shinto Shrine is known for its towering gate and surrounding woods. The Imperial Palace sits amid large public gardens.",
                ImageName = "tokyo.jpg",
                URL = "https://en.wikipedia.org/wiki/Tokyo"
            }
        };
        FrameworkData.AddRange(data);
        maxValue = FrameworkData.Count - 1;
    }
    private void AddItemWithIndex()
    {
        int count = FrameworkData.Count;
        FrameworkDetails data = new FrameworkDetails
        {
            ID = count,
            Title = "London",
            Content = "London, the capital of England and the United Kingdom, is a 21st-century city with history stretching back to Roman times. At its centre stand the imposing Houses of Parliament, the iconic 'Big Ben' clock tower and Westminster Abbey, site of British monarch coronations.",
            ImageName = "london.jpg",
            URL = "https://en.wikipedia.org/wiki/London"
        };
        if (CarouselIndex < FrameworkData.Count)
        {
            FrameworkData.Insert(CarouselIndex, data);
        }
        maxValue = FrameworkData.Count - 1;
    }
    private void RemoveItem()
    {
        if (FrameworkData.Count > 1)
        {
            FrameworkDetails data = FrameworkData.Last();
            FrameworkData.Remove(data);
            maxValue = FrameworkData.Count - 1;
        }
    }
    private void RemoveItemRange()
    {
        if (FrameworkData.Count > 2)
        {
            FrameworkData.RemoveRange(FrameworkData.Count - 2, 2);
            maxValue = FrameworkData.Count - 1;
        }
    }
    private void RemoveItemWithIndex()
    {
        if (FrameworkData.Count > 1 && FrameworkData.Count > CarouselIndex)
        {
            FrameworkData.RemoveAt(CarouselIndex);
            maxValue = FrameworkData.Count - 1;
        }
    }
    private void DisposeCarousel()
    {
        renderCarousel = false;
    }
    public class FrameworkDetails
    {
        public int ID { get; set; }
        public string Title { get; set; }
        public string Content { get; set; }
        public string ImageName { get; set; }
        public string URL { get; set; }
    }
}
<style>
    .carousel-sample {
        border: 1px solid #e5e5e5;
        border-radius: 0.5em;
        margin: 0 auto 2em;
        max-width: 420px;
        height: 420px;
    }

    .db-carousel {
        background-color: inherit;
        border-radius: 0.5em;
    }

    .db-carousel .e-carousel-items .e-carousel-item .card-title,
    .db-carousel .e-carousel-items .e-carousel-item .card-text {
        opacity: 0;
        text-align: justify;
        transform: translateY(20px);
    }

    .db-carousel .e-carousel-items .e-carousel-item.e-active .card-title,
    .db-carousel .e-carousel-items .e-carousel-item.e-active .card-text {
        opacity: 1;
        transform: translateY(0px);
    }

    .db-carousel .e-carousel-items .e-carousel-item .card-title {
        font-size: 20px;
        transition: transform 0.4s ease 0.2s;
    }

    .db-carousel .e-carousel-items .e-carousel-item .card-text {
        font-size: 14px;
        transition: transform 0.4s ease 0.2s;
    }

    .db-carousel .e-carousel-indicators {
        height: 3em;
    }

    .db-carousel .e-carousel-indicators.e-default .e-indicator-bar .e-indicator div {
        background-color: #e7e7e7;
    }
</style>