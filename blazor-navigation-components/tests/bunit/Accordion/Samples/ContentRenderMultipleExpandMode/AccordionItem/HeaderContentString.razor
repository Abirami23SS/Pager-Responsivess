@page "/ContentRenderMultipleExpandMode/AccordionItem/HeaderContentString"

@using Syncfusion.Blazor.Navigations

<br />
<span>ExpandFirstItemValue: @string.Join(",", ExpandFirstItem)</span>
<br />
<span>ExpandSecondItemValue: @string.Join(",", ExpandSecondItem)</span>
<br />

<SfAccordion LoadOnDemand="false">
    <AccordionItems>
        <AccordionItem @bind-Expanded="ExpandFirstItem" Header="ASP.NET" Content="Microsoft ASP.NET is a set of technologies in the Microsoft .NET Framework for building Web applications and XML Web services. ASP.NET pages execute on the server and generate markup such as HTML, WML, or XML that is sent to a desktop or mobile browser. ASP.NET pages use a compiled,event-driven programming model that improves performance and enables the separation of application logic and user interface."></AccordionItem>
        <AccordionItem @bind-Expanded="ExpandSecondItem" Header="ASP.NET MVC" Content="The Model-View-Controller (MVC) architectural pattern separates an application into three main components: the model, the view, and the controller. The ASP.NET MVC framework provides an alternative to the ASP.NET Web Forms pattern for creating Web applications. The ASP.NET MVC framework is a lightweight, highly testable presentation framework that (as with Web Forms-based applications) is integrated with existing ASP.NET features, such as master pages and membership-based authentication."></AccordionItem>
    </AccordionItems>
</SfAccordion>

@code {
    public bool ExpandFirstItem = true;
    public bool ExpandSecondItem = true;
}