@page "/ContentRenderSingleExpandMode/AccordionItem/HeaderContentString"

@using Syncfusion.Blazor.Navigations

<br />
<span>ExpandItemValue: @string.Join(",", ExpandItem)</span>
<br />

<SfAccordion LoadOnDemand="false" ExpandMode="ExpandMode.Single">
    <AccordionItems>
        <AccordionItem @bind-Expanded="ExpandItem" Header="ASP.NET" Content="Microsoft ASP.NET is a set of technologies in the Microsoft .NET Framework for building Web applications and XML Web services. ASP.NET pages execute on the server and generate markup such as HTML, WML, or XML that is sent to a desktop or mobile browser. ASP.NET pages use a compiled,event-driven programming model that improves performance and enables the separation of application logic and user interface."></AccordionItem>
    </AccordionItems>
</SfAccordion>

@code {
    public bool ExpandItem = true;
}