@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons

@namespace Syncfusion.Blazor.Tests.Navigations

<SfBreadcrumb EnableNavigation="false" EnableActiveItemNavigation=@activenavigation ActiveItem=@active_item>
<BreadcrumbItems>
    <BreadcrumbItem Text="Home" Url="../"></BreadcrumbItem>
    <BreadcrumbItem Text="Breadcrumb" Url="./breadcrumb"></BreadcrumbItem>
    <BreadcrumbItem Text="Items" Url="./breadcrumb/items"></BreadcrumbItem>
    <BreadcrumbItem Text="Active Item" Url="./breadcrumb/activeItem"></BreadcrumbItem>
    <BreadcrumbItem Text="OverflowMode" Url="./breadcrumb/overflowmode"></BreadcrumbItem>
    <BreadcrumbItem Text="Icons" Url="./breadcrumb/icons"></BreadcrumbItem>
    <BreadcrumbItem Text="Separator" Url="./breadcrumb/separatorandattribute"></BreadcrumbItem>
    <BreadcrumbItem Text="BindToLocation" Url="./breadcrumb/bindtolocation"></BreadcrumbItem>
    <BreadcrumbItem Text="Width" Url="./breadcrumb/width"></BreadcrumbItem>
</BreadcrumbItems>
</SfBreadcrumb>

<SfButton IsPrimary="true" CssClass="e-brd-btn" @onclick="click">Click</SfButton>

@code {
    [Parameter]
    public string active_item {get;set;}="./breadcrumb/activeItem";
    [Parameter]
    public bool activenavigation {get;set;}=true;
    private void click()
    {
        active_item = "./breadcrumb/items";
    }
}
