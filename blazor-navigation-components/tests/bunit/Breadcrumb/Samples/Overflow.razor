        </BreadcrumbItems>
    </SfBreadcrumb>
    <br/>
        <SfBreadcrumb EnableNavigation="false" ActiveItem="@ScrollActiveItem" OverflowMode="BreadcrumbOverflowMode.Scroll" style="width:300px">
            <BreadcrumbItems>
                <BreadcrumbItem Text="Home" Url="./"/>
                <BreadcrumbItem Text="Breadcrumb" Url="./breadcrumb"/>
                <BreadcrumbItem Text="Default" Url="./breadcrumb/default"/>
                <BreadcrumbItem Text="Icons" Url="./breadcrumb/icons"/>
                <BreadcrumbItem Text="Navigation" Url="./breadcrumb/navigation"/>
                <BreadcrumbItem Text="Overflow" Url="./breadcrumb/overflow"/>
            </BreadcrumbItems>
        </SfBreadcrumb>
</div>
@code {
    private string MenuActiveItem = "Overflow";
    private string HiddenActiveItem = "Overflow";    
    private string CollapsedActiveItem = "Overflow";
    private string WrapActiveItem = "Overflow";
    private string ScrollActiveItem = "Overflow";
}
